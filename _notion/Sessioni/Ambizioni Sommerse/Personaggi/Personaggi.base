# Personaggi

filters:
  and:
    - note["base"] == link("Personaggi.base")
properties:
  file.name:
    displayName: Name
  Fazione:
    displayName: Fazione
  Ruolo:
    displayName: Ruolo
  Regione:
    displayName: Regione
  Info:
    displayName: Info
  Posizione:
    displayName: Posizione
views:
  - type: table
    name: Table View
    order:
      - file.name
      - Fazione
      - Ruolo
      - Regione
      - Info
      - Posizione
