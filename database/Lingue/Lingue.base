filters:
  and:
    - note["base"] == link("Lingue.base")
properties:
  file.name:
    displayName: Nome
  Gruppo:
    displayName: Gruppo
  Rarità:
    displayName: Rarità
  note.Famiglia:
    displayName: Famiglia
  note.Alfabeto:
    displayName: Alfabeto
  note.Continente:
    displayName: Continente
  note.famiglia:
    displayName: Famiglia
  note.continente:
    displayName: Continente
views:
  - type: table
    name: Table View
    order:
      - file.name
      - Famiglia
      - Alfabeto
      - Rarità
      - Continente
    sort:
      - property: base
        direction: ASC
  - type: cards
    name: View
    cardSize: 100
    imageAspectRatio: 1
