filters:
  and:
    - note["base"] == link("Lingue.base")
properties:
  file.name:
    displayName: Nome
  Gruppo:
    displayName: Gruppo
  Rarità:
    displayName: Rarità
  note.Famiglia:
    displayName: Famiglia
  note.Alfabeto:
    displayName: Alfabeto
  note.Continente:
    displayName: Continente
  note.famiglia:
    displayName: Famiglia
  note.continente:
    displayName: Continente
views:
  - type: table
    name: Table View
    order:
      - file.name
      - Famiglia
      - Alfabeto
      - Rarità
      - Continente
    sort:
      - property: base
        direction: ASC
  - type: cards
    name: Liria
    filters:
      and:
        - continente.contains("Liria")
    order:
      - file.name
      - famiglia
      - Rarità
    cardSize: 120
    imageAspectRatio: 1
  - type: cards
    name: Eloran
    filters:
      and:
        - continente.contains("Eloran")
    order:
      - file.name
      - famiglia
      - Rarità
    cardSize: 120
    imageAspectRatio: 1
