filters:
  and:
    - note["base"] == link("Personaggi.base")
properties:
  file.name:
    displayName: Name
  Fazione:
    displayName: Fazione
  Ruolo:
    displayName: Ruolo
views:
  - type: table
    name: Table View
    order:
      - file.name
  - type: table
    name: Marina Reale
    filters:
      and:
        - Fazione.contains("Marina Reale")
    order:
      - file.name
      - Ruolo
  - type: table
    name: Corsari
    filters:
      and:
        - Fazione.contains("Corsari")
    order:
      - file.name
      - Ruolo
  - type: table
    name: Repubblica degli Emir
    filters:
      and:
        - Fazione.contains("Repubblica degli Emir")
    order:
      - file.name
      - Ruolo
  - type: table
    name: Pirati
    filters:
      and:
        - Fazione.contains("Pirati")
    order:
      - file.name
      - Ruolo
  - type: table
    name: Sindacato delle Forge
    filters:
      and:
        - Fazione.contains("Sindacato delle Forge")
    order:
      - file.name
      - Ruolo
  - type: table
    name: Figli del Gelo
    filters:
      and:
        - Fazione.contains("Figli del Gelo")
    order:
      - file.name
      - Ruolo
  - type: table
    name: Nobiltà Occidentale
    filters:
      and:
        - Fazione.contains("Nobiltà Occidentale")
    order:
      - file.name
      - Ruolo
  - type: table
    name: Covata Reale
    filters:
      and:
        - Fazione.contains("Covata Reale")
    order:
      - file.name
      - Ruolo
  - type: table
    name: Drakkari
    filters:
      and:
        - Fazione.contains("Drakkari")
    order:
      - file.name
      - Ruolo
  - type: table
    name: Gilda degli Avventurieri
    filters:
      and:
        - Fazione.contains("Gilda degli Avventurieri")
    order:
      - file.name
      - Ruolo
  - type: table
    name: Legione di Bronzo
    filters:
      and:
        - Fazione.contains("Legione di Bronzo")
    order:
      - file.name
      - Ruolo
